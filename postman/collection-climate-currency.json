      "name": "OpenWeatherMap - Clima Actual",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.openweathermap.org/data/2.5/weather?q=Bogota&appid=demo&units=metric",
          "protocol": "https",
          "host": ["api", "openweathermap", "org"],
          "path": ["data", "2.5", "weather"],
          "query": [
            {"key": "q", "value": "Bogota"},
            {"key": "appid", "value": "demo"},
            {"key": "units", "value": "metric"}
          ]
        }
      },
      "response": []
    },
